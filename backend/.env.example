# API
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=500
TDEED_THRESHOLD=0.30

# T-DEED: mount the official upstream checkout at this path and place the
# compatible SoccerNet Ball checkpoint in its expected checkpoint directory.
TDEED_DIR=/opt/T-DEED
TDEED_MODEL=SoccerNetBall_challenge1
# Optional direct HTTPS checkpoint URL. Only set this to an official/trusted
# direct file URL; prefer mounting a verified checkpoint file instead.
# TDEED_CHECKPOINT_URL=

# Player detection: set to a compatible local Ultralytics weights file.
# Do not assume arbitrary COCO weights identify a footballer by name.
PP_TRACKER_MODEL=/models/yolo-person.pt
