# API
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=500
TDEED_THRESHOLD=0.30

# The Docker image builds the pinned T-DEED source into /opt/T-DEED.
TDEED_DIR=/opt/T-DEED
TDEED_MODEL=SoccerNetBall_challenge1
TDEED_CHECKPOINT_PATH=/models/SoccerNetBall_challenge1/checkpoint_best.pt

# Only use a direct HTTPS URL if it is an official, verified checkpoint file.
# The upstream Google Drive folder URL is not a direct download URL.
# TDEED_CHECKPOINT_URL=

# Person detector weights must be placed in backend/models/yolo-person.pt.
# Tracks are anonymous IDs; these weights do not identify named footballers.
PP_TRACKER_MODEL=/models/yolo-person.pt
